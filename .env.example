# =============================================================================
# 交付 Demo：复制为仓库根目录 .env 后填写（勿提交真实密钥）
#   cp .env.example .env
# 修改后重启：npm run dev
# 自检：curl -s http://127.0.0.1:3001/api/health
# =============================================================================

# —— 必填：TRTC（服务端签发 UserSig）
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# 与 TRTC_SDK_APP_ID 相同，供前端展示（可公开）
VITE_TRTC_SDK_APP_ID=

# —— 必填：数智人 aPaaS
# 控制台：https://xiaowei.cloud.tencent.com/ivh#/asserts_management
# 签名说明：https://cloud.tencent.com/document/product/1240/107197
IVH_APP_KEY=
IVH_ACCESS_TOKEN=
IVH_VIRTUALMAN_PROJECT_ID=

# 可选：API 端口（默认 3001）
# API_PORT=3001

# 可选：数智人 TRTC UserId 前缀
# IVH_TRTC_USER_ID=virtualhuman_anchor1
# IVH_TRTC_PRIVATE_MAP_KEY=dummy
# IVH_BASE_URL=https://gw.tvs.qq.com

# 勿设（除非联调省并发）：设为 1 会在首句播报后 closesession，画面会断
# IVH_AUTO_CLOSE_SESSION=1

# 可选：开始直播时的欢迎语
# STUDIO_WELCOME_TEXT=欢迎来到直播间，我是数字人主播。

# —— 可选：真实 LLM（OpenAI 兼容）；不设则占位回复
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_FALLBACK_PLACEHOLDER=1

# —— 历史能力：设置 1 启用 IM / presubmit / 旧数字人 API（见 archive/README.md）
# ARCHIVE_LEGACY=1
# IM_REST_ADMIN_USER_ID=
# IM_GROUP_ID_PREFIX=
# IM_GROUP_ID_SUFFIX=
