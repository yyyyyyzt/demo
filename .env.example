# =============================================================================
# 本地联调：复制本文件为仓库根目录的 .env 后填写（勿把真实密钥提交到 Git）
#   cp .env.example .env
# 修改后须重启 API：npm run server 或 npm run dev
# 自检：curl -s http://127.0.0.1:3001/api/health | jq
# =============================================================================

# —— 腾讯云 TRTC / TUILiveKit（服务端签发 UserSig）
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# 与 TRTC_SDK_APP_ID 相同，供前端表单默认值（可公开）
VITE_TRTC_SDK_APP_ID=

# 可选：API 端口，默认 3001
# API_PORT=3001

# —— 腾讯云智能数智人 aPaaS（云渲染 HTTP）
# 获取 AppKey / AccessToken：数智人控制台 → 资源管理
#   https://xiaowei.cloud.tencent.com/ivh#/asserts_management
# 签名与调用说明：
#   https://cloud.tencent.com/document/product/1240/107197
# 三项都填全后，GET /api/health 中 ivhConfigured 为 true，数字人任务才会请求 gw.tvs.qq.com
IVH_APP_KEY=
IVH_ACCESS_TOKEN=
IVH_VIRTUALMAN_PROJECT_ID=

# 数智人进 TRTC 房间的 UserId，须与 anchor_* / mod_* / 观众等互不重复
# IVH_TRTC_USER_ID=virtualhuman_anchor1

# TRTC PrivateMapKey；未开启高级权限时可固定 dummy（与官方示例一致）
# IVH_TRTC_PRIVATE_MAP_KEY=dummy

# 可选：网关，默认 https://gw.tvs.qq.com
# IVH_BASE_URL=https://gw.tvs.qq.com

# 设为 1 时，创建数字人任务必须走 comment-presubmit + presubmit_ticket（禁止仅传 comment_text）
# DH_JOB_REQUIRE_TICKET=1

# —— IM REST：主持人「批准显示」时代发群消息（须与 IM 控制台「App 管理员」一致）
# 文档：https://cloud.tencent.com/document/product/269/1629
# IM_REST_ADMIN_USER_ID=your_im_admin_userid

# 若直播群 GroupId 不是裸 liveId，可前后拼接（默认前后均为空，即 GroupId = liveId）
# IM_GROUP_ID_PREFIX=
# IM_GROUP_ID_SUFFIX=

# 非中国站可改域名，默认 https://console.tim.qq.com
# IM_REST_API_DOMAIN=https://console.tim.qq.com
