# =============================================================================
# 数字人直播 · 交付 Demo（生产标准：OBS 拉流转推 + IM 评论链路）
#   cp .env.example .env
# 修改后重启：npm run dev
# 自检：curl -s http://127.0.0.1:3001/api/health
# =============================================================================

# —— 必填：TRTC（服务端签发 UserSig、生成 OBS 推流地址）
#    与 IM / TUILiveKit 同一个 SDKAppID 应用；SECRETKEY 同时用于 IM REST 签名。
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# 与 TRTC_SDK_APP_ID 相同，供前端展示（可公开）
VITE_TRTC_SDK_APP_ID=

# —— 必填：数智人 aPaaS（云渲染）
# 控制台：https://xiaowei.cloud.tencent.com/ivh#/asserts_management
# 签名说明：https://cloud.tencent.com/document/product/1240/107197
IVH_APP_KEY=
IVH_ACCESS_TOKEN=
IVH_VIRTUALMAN_PROJECT_ID=

# —— 必填：IM 评论链路 / TUILiveKit 直播间登记（App 管理员账号）
#    评论真走腾讯 IM；撤回/禁言依赖该管理员身份调用 IM REST。
#    控制台 → 应用配置 → 账号管理 创建的 App 管理员 userId。
IM_REST_ADMIN_USER_ID=
# 或复用：TUILIVE_REST_ADMIN_USER_ID=

# 设为 0 则开播时不调用 TUILiveKit create_room（默认会登记，便于在直播管理后台可见）
# TUILIVE_REGISTER_ON_STUDIO=0

# —— 可选：API 端口（默认 3001）
# API_PORT=3001

# —— 可选：开播欢迎语 / 默认禁言时长（秒）
# STUDIO_WELCOME_TEXT=各位观众朋友大家好，欢迎来到本场惠民政策宣讲直播间。
# STUDIO_MUTE_SECONDS=600

# —— 可选：数智人进阶参数
# IVH_TRTC_USER_ID=virtualhuman_anchor1
# IVH_TRTC_PRIVATE_MAP_KEY=dummy
# IVH_BASE_URL=https://gw.tvs.qq.com
# 勿设（除非联调省并发）：设为 1 会在首句播报后 closesession，画面会断
# IVH_AUTO_CLOSE_SESSION=1

# —— 可选：真实 LLM（OpenAI 兼容）；不设则用占位回复话术
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_FALLBACK_PLACEHOLDER=1

# —— 可选：IM 群 ID 前后缀（默认群 ID = liveId，与 TUILiveKit create_room 对齐）
# IM_GROUP_ID_PREFIX=
# IM_GROUP_ID_SUFFIX=

# —— 历史能力：设置 1 启用旧 IM / presubmit / 旧数字人 API（见 archive/README.md）
# ARCHIVE_LEGACY=1
